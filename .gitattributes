# Normalización de fin de línea: el repositorio es markdown y se lee igual en
# todas las plataformas.
* text=auto eol=lf

*.md      text eol=lf
*.yml     text eol=lf
*.json    text eol=lf

# Binarios: nunca tocar.
*.png     binary
*.jpg     binary
*.gif     binary
*.ico     binary

