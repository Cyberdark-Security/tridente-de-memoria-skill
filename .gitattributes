# Normalización de fin de línea. Sin esto, un clon en Windows convierte los
# scripts .sh a CRLF y dejan de ejecutarse ("bad interpreter: /usr/bin/env^M").
* text=auto eol=lf

*.sh      text eol=lf
*.mjs     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# PowerShell necesita CRLF + BOM UTF-8 para Windows PowerShell 5.1.
*.ps1     text eol=crlf working-tree-encoding=UTF-8

# Binarios: nunca tocar.
*.png     binary
*.jpg     binary
*.gif     binary
*.ico     binary

# Excluir del tarball de release y de las estadísticas de lenguaje.
banner.png       linguist-documentation
templates/*.md   linguist-documentation
